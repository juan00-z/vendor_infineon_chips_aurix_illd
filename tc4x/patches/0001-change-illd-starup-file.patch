diff --git a/src/Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h b/src/Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h
index a64de56..8d62e72 100644
--- a/src/Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h
+++ b/src/Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_CompilersGcc.h
@@ -82,6 +82,7 @@
 /*C extern defintions */
 #define IFX_SSW_CORE_LINKER_SYMBOLS(cpu)                                        \
     extern unsigned int __USTACK##cpu[];      /**< user stack end */            \
+    extern unsigned int __USTACK##cpu##_END[];/**< user stack */                \
     extern unsigned int __ISTACK##cpu[];      /**< interrupt stack end */       \
     extern unsigned int __INTTAB_CPU##cpu[];  /**< Interrupt vector table */    \
     extern unsigned int __TRAPTAB_CPU##cpu[]; /**< trap table */                \
@@ -89,6 +90,7 @@
     extern unsigned int __CSA##cpu##_END[];   /**< context save area 1 end */
 
 #define __USTACK(cpu)      __USTACK##cpu
+#define __USTACK_END(cpu)  __USTACK##cpu##_END
 #define __ISTACK(cpu)      __ISTACK##cpu
 #define __INTTAB_CPU(cpu)  __INTTAB_CPU##cpu
 #define __TRAPTAB_CPU(cpu) __TRAPTAB_CPU##cpu
@@ -132,7 +134,9 @@ typedef volatile union
 /******************************************************************************/
 /*----------------------------   GNU Intrinsics  -----------------------------*/
 /******************************************************************************/
+#ifndef STRINGIFY
 #define STRINGIFY(x)    #x
+#endif
 
 /* Assembly function to configure the Stack pointer and jump to core start */
 #define Ifx_Ssw_Start(stackPtr, funcPtr) __Ifx_Ssw_Start(stackPtr, funcPtr)
diff --git a/src/Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.c b/src/Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.c
