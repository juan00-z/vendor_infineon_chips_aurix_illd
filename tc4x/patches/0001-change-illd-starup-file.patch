+++ b/src/Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Infra.c
@@ -429,6 +429,7 @@ void Ifx_Ssw_doCppInit(void)
 {
     Ifx_Ssw_C_InitInline();
 
+#ifndef __NuttX__
 #ifdef __TASKING__
     extern void _main(void); /* cpp initialization */
     _main();
@@ -451,6 +452,7 @@ void Ifx_Ssw_doCppInit(void)
 #elif defined(__DCC__)
     /* Cpp Init part of the init_main called in C Init Inline */
 #endif
+#endif
 }
 
 void Ifx_Ssw_doCppExit(int status)
diff --git a/src/Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c b/src/Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c
index 5fccc5c..eb1b69c 100644
--- a/src/Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c
+++ b/src/Libraries/Infra/Ssw/TC4xx/Tricore/Ifx_Ssw_Tc0.c
@@ -171,7 +171,9 @@ static void __StartUpSoftware(void)
     /* Point the FCX to PSPR needed for disabling virtualization */
     Ifx_Ssw_MTCR(CPU_FCX, IFX_CFG_SSW_CSA_PTR(IFX_CFG_SSW_CSA_BOOT_PTR_START));
 
+#ifdef CONFIG_TRICORE_BL
     Ifx_Ssw_disableVirtualization_Cpu0();
+#endif
 
     /* Re-Initialize the BTV to the HRA context post disabling virtualization */
     Ifx_Ssw_MTCR(CPU_BTV, (unsigned int)__TRAPTAB(0));
@@ -202,13 +204,15 @@ static void __StartUpSoftware(void)
 	
 	/* FW_Check incl. SMU Alarm Flag check */
     Ifx_Ssw_FwCheck();
-    
+
+#ifdef CONFIG_TRICORE_BL
     /* This phase is executed only if last reset is not of type application reset */
     if (Ifx_Ssw_isApplicationReset() != 1U)
     {
         Ifx_Ssw_jumpToFunction(__StartUpSoftware_Phase2);
     }
     else
+#endif
     {
         if(Ifx_Ssw_isKeyoffMarkerSet())
 		{
@@ -276,9 +280,11 @@ static void __StartUpSoftware_Phase3(void)
     Ifx_Ssw_jumpToFunctionWithLink(__CStartBasic);
     Ifx_Ssw_Barrier();
 
+#ifdef CONFIG_TRICORE_BL
     /* MBIST Tests and evaluation for SSHs other than DSPR0-5 and DMARAM */
     Ifx_Ssw_Mbist();
-    
+#endif
+
     /* Hook functions to initialize application specific HW extensions */
     hardware_init_hook();
 
@@ -498,7 +504,7 @@ static void __CStartBasic(void)
     Ifx_Ssw_DSYNC();
     /*Initialize the context save area for CPU0. Function Calls Possible */
     /* Setup the context save area linked list */
-    Ifx_Ssw_initCSA((unsigned int *)__CSA(0), (unsigned int *)__CSA_END(0));
+    Ifx_Ssw_initCSA((unsigned int *)__USTACK_END(0), (unsigned int *)__USTACK(0));
 
     Ifx_Ssw_jumpBackToLink();
 }
