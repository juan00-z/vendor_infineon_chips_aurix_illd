+void IfxVmt_clearStandbyram(IfxVmt_MbistSel mbistSel, uint32 standbyramsize)
+{
+    Ifx_VMT_MC *cpuDlmu;
+
+    /* only cpu0 and cpu1 is accepted because only cpu0/1 have stbyram */
+
+    if (mbistSel != IfxVmt_MbistSel_cpu0DlmuStby && mbistSel != IfxVmt_MbistSel_cpu1DlmuStby)
+    {
+        return;
+    }
+
+    if (standbyramsize > 0)
+    {
+        IfxVmt_enableMbistShell(mbistSel);
+
+        cpuDlmu = IfxVmt_getDmtuMcInstancePtr(mbistSel);
+
+        cpuDlmu->RDBFL[0].B.WDATA = 0x0000;
+        cpuDlmu->RDBFL[1].B.WDATA = 0x0000;
+        cpuDlmu->RDBFL[2].B.WDATA = 0x0000;
+        cpuDlmu->RDBFL[3].B.WDATA = 0x0000;
+        cpuDlmu->RDBFL[4].B.WDATA = 0x0003;
+        cpuDlmu->RDBFL[5].B.WDATA = 0x0000;
+        cpuDlmu->RDBFL[6].B.WDATA = 0x0000;
+        cpuDlmu->RDBFL[7].B.WDATA = 0x0000;
+        cpuDlmu->RDBFL[8].B.WDATA = 0x0300;
+
+        cpuDlmu->RANGE.B.RAEN = 1;
+        cpuDlmu->RANGE.B.ADDR = (0x7F << 7) + ((standbyramsize * 1024) / (256 * 16) & 0x7F);
+
+        cpuDlmu->MCONTROL.B.DINIT = 1;
+        cpuDlmu->MCONTROL.B.START = 1;
+        cpuDlmu->MCONTROL.B.START = 0;
+
+        while (!IfxVmt_isMbistDone(mbistSel))
+        {
+            __nop();
+        }
+
+        IfxVmt_disableMbistShell(mbistSel);
+    }
+}
