+IFX_INLINE uint16 IfxPmsPm_getStandbyRam0Size(Ifx_PMS *pms)
+{
+    uint16_t ramsel = pms->STANDBY.CON0.B.SBRAMSEL;
+
+    if (ramsel == IfxPmsPm_StandbyRamSupply_cpu0_64Kb ||
+        ramsel == IfxPmsPm_StandbyRamSupply_cpu0_64Kb_cpu1_64Kb ||
+        ramsel == IfxPmsPm_StandbyRamSupply_cpu0_64Kb_cpu1_128Kb)
+        return 64;
+    else if (ramsel == IfxPmsPm_StandbyRamSupply_cpu0_128Kb ||
+             ramsel == IfxPmsPm_StandbyRamSupply_cpu0_128Kb_cpu1_64Kb ||
+             ramsel == IfxPmsPm_StandbyRamSupply_cpu0_128Kb_cpu1_128Kb)
+        return 128;
+
+    return 0;
+}
+
+
+IFX_INLINE uint16 IfxPmsPm_getStandbyRam1Size(Ifx_PMS *pms)
+{
+    uint16_t ramsel = pms->STANDBY.CON0.B.SBRAMSEL;
+
+    if (ramsel == IfxPmsPm_StandbyRamSupply_cpu1_64Kb ||
+        ramsel == IfxPmsPm_StandbyRamSupply_cpu0_64Kb_cpu1_64Kb ||
+        ramsel == IfxPmsPm_StandbyRamSupply_cpu0_128Kb_cpu1_64Kb)
+        return 64;
+    else if (ramsel == IfxPmsPm_StandbyRamSupply_cpu1_128Kb ||
+             ramsel == IfxPmsPm_StandbyRamSupply_cpu0_64Kb_cpu1_128Kb ||
+             ramsel == IfxPmsPm_StandbyRamSupply_cpu0_128Kb_cpu1_128Kb)
+        return 128;
+
+    return 0;
+}
