+IFX_INLINE void IfxFlashCsrm_clearStatus(uint32 flash)
+{
+    IFX_UNUSED_PARAMETER(flash);
+    volatile uint32 *addr1 = (volatile uint32 *)(IFXFLASHCSRM_CMD_BASE_ADDRESS | 0x5554);
+
+    *addr1 = 0xFA;
+
+    __dsync();
+}
