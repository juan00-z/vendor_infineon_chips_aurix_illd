+IFX_INLINE uint8 IfxFlashCsrm_enterPageMode(uint32 pageAddr)
+{
+    volatile uint32 *addr1 = (volatile uint32 *)(IFXFLASHCSRM_CMD_BASE_ADDRESS | 0x5554);
+
+    IFX_ASSERT(IFX_VERBOSE_LEVEL_ERROR, (IfxFlashCsrm_isAddressBelongToCsrmBank(pageAddr) == IfxFlash_Status_success));
+
+    if (((pageAddr >= IFXFLASHCSRM_PFLASH_START) && (pageAddr <= IFXFLASHCSRM_PFLASH_END)) || \
+        ((pageAddr >= IFXFLASHCSRM_PFLASH_P00_START) && (pageAddr <= IFXFLASHCSRM_PFLASH_P51_END)))   // program flash
+    {
+        *addr1 = 0x50;
+        return 0;
+    }
+    else if (((pageAddr >= IFXFLASHCSRM_DFLASH_START) && (pageAddr <= IFXFLASHCSRM_DFLASH_END)) ||         \
+             ((pageAddr >= IFXFLASHCSRM_UCB1_START) && (pageAddr <= IFXFLASHCSRM_UCB1_END)) ||             \
+             ((pageAddr >= IFXFLASHCSRM_HOSTDFLASH_START) && (pageAddr <= IFXFLASHCSRM_HOSTDFLASH_END)) || \
+             ((pageAddr >= IFXFLASHCSRM_UCB0_START) && (pageAddr <= IFXFLASHCSRM_UCB0_END))) // data flash
+    {
+        *addr1 = 0x5D;
+        return 0;
+    }
+
+    __dsync();
+
+    return 1; // invalid flash address
+}
