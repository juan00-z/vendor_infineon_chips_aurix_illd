+IFX_INLINE uint8 IfxFlashCsrm_waitUnbusy(uint32 flash, IfxFlash_FlashType flashType, uint32 timeout)
+{
+    uint8 status = 0;
+    volatile uint32 timeoutticks;
+
+    if (flash != 0)
+    {
+        return 1;
+    }
+
+    timeoutticks =  timeout ? timeout * IFXFLASHCSRM_OPERATION_TIMEOUT_1US : IFXFLASHCSRM_MAX_OPERATION_TIMEOUT;
+
+    while ((DMU_CSCI_STATUS.U & (1 << flashType)))
+    {
+        if (timeoutticks-- == 0)
+        {
+            status = 1;
+            break;
+        }
+    }
+
+    __dsync();
+    return status;
+}
