+IFX_INLINE IfxFlash_Status IfxFlashCsrm_isBankAllocatedToCsrm(IfxFlash_FlashType flash)
+{
+    return (MODULE_DMU.GP.BKALLOC.U & (1U << flash)) ? IfxFlash_Status_success : IfxFlash_Status_failure;
+}
