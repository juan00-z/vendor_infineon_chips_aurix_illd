+IFX_INLINE IfxFlash_FlashType IfxFlashCsrm_getBankFromAddress(uint32 address)
+{
+    IfxFlash_FlashType flash = IfxFlash_FlashType_Invalid;
+    uint8                  index = 0U;
+    uint32                 localPageAddr;
+    uint32                 size  = 0u;
+
+    if ((address >= IFXFLASHCSRM_PFLASH_START) && (address <= IFXFLASHCSRM_PFLASH_END)) //CSRM PFLASH
+    {
+        flash = IfxFlash_FlashType_PCsrm;
+    }
+    else if (((address >= IFXFLASHCSRM_PFLASH_P00_START) && (address <= IFXFLASHCSRM_PFLASH_P51_END))) /* Host PFlash */
+    {
+        localPageAddr = address - IFXFLASHCSRM_PFLASH_P00_START;
+
+        for (index = 1U; index <= IFXFLASHCSRM_HOSTPFLASH_BANKS; index++)
+        {
+            size += IfxFlashCsrm_flashSize[index - 1U];
+
+            if (localPageAddr < size)
+            {
+                flash = (IfxFlash_FlashType)(index - 1U);
+                break;
+            }
+        }
+    }
+    else if (((address >= IFXFLASHCSRM_DFLASH_START) && (address <= IFXFLASHCSRM_DFLASH_END)) || \
+             ((address >= IFXFLASHCSRM_UCB1_START) && (address <= IFXFLASHCSRM_UCB1_END)))
+    {
+        flash = IfxFlash_FlashType_DCsrm;
+    }
+    else if (((address >= IFXFLASHCSRM_HOSTDFLASH_START) && (address <= IFXFLASHCSRM_HOSTDFLASH_END)) || \
+             ((address >= IFXFLASHCSRM_UCB0_START) && (address <= IFXFLASHCSRM_UCB0_END))) //Host data flash
+    {
+        flash = IfxFlash_FlashType_DHost;
+    }
+    else
+    {
+        flash = IfxFlash_FlashType_Invalid;
+    }
+
+    return flash;
+}
